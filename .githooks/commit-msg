#!/usr/bin/env sh
set -eu

COMMIT_MSG_FILE="$1"

IFS= read -r SUBJECT < "$COMMIT_MSG_FILE" || SUBJECT=""

case "$SUBJECT" in
  "Merge "* | "Revert "* | "fixup!"* | "squash!"* | "#"*)
    exit 0
    ;;
esac

PATTERN='^(feat|fix|perf|refactor|docs|test|build|ci|chore|revert)(\([a-z0-9/_-]+\))?!?: .+'

if printf '%s\n' "$SUBJECT" | grep -Eq "$PATTERN"; then
  exit 0
fi

cat >&2 <<'EOF'
✖ Commit subject is not a Conventional Commit.

Expected:  <type>[(scope)][!]: <description>
Types:     feat, fix, perf, refactor, docs, test, build, ci, chore, revert
Breaking:  append "!" (feat!: ...) or add a "BREAKING CHANGE:" footer.

Example:   feat(installer): verify tarball checksum before extraction

See https://www.conventionalcommits.org/. The same check runs in CI and blocks
the merge there.
EOF

exit 1
