# Shared by every recording; see README.md.
Set Shell "bash"
Set FontFamily "JetBrains Mono"
Set FontSize 17
Set Width 1280
Set Height 720
Set Padding 28
Set TypingSpeed 35ms
Set Theme { "name": "agemon", "background": "#0d1620", "foreground": "#e8edf2", "cursor": "#5bb8f0", "selection": "#26384c", "black": "#142130", "red": "#f0707a", "green": "#5fcf9a", "yellow": "#e3b341", "blue": "#5bb8f0", "magenta": "#d9a441", "cyan": "#7cc8f5", "white": "#e8edf2", "brightBlack": "#566f8a", "brightRed": "#f0707a", "brightGreen": "#5fcf9a", "brightYellow": "#e3b341", "brightBlue": "#7cc8f5", "brightMagenta": "#d9a441", "brightCyan": "#7cc8f5", "brightWhite": "#ffffff" }
