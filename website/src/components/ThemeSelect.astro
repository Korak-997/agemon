<button type="button" class="ag-icon-button theme-toggle" data-theme-toggle aria-label="Switch colour theme">
  <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
    <circle cx="10" cy="10" r="6.5"></circle>
    <path d="M10 3.5v13"></path>
    <path d="M10 3.5a6.5 6.5 0 0 1 0 13z" fill="currentColor"></path>
  </svg>
</button>

<script>
  const STARLIGHT_THEME_STORAGE_KEY = "starlight-theme";

  for (const button of document.querySelectorAll("[data-theme-toggle]")) {
    button.addEventListener("click", () => {
      const nextTheme =
        document.documentElement.dataset.theme === "light" ? "dark" : "light";
      document.documentElement.dataset.theme = nextTheme;
      localStorage.setItem(STARLIGHT_THEME_STORAGE_KEY, nextTheme);
    });
  }
</script>

<style>
  .theme-toggle svg {
    transition: transform 200ms var(--ease-in-out);
  }

  .theme-toggle:hover svg {
    transform: rotate(180deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-toggle svg {
      transition: none;
    }
  }
</style>
