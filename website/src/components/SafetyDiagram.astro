---
const steps = [
  {
    name: "plan",
    text: "Shows what will change, with diffs, before anything is written.",
    detail: "+ / - per line",
  },
  {
    name: "consent",
    text: "Nothing is applied until you say yes.",
    detail: "proceed? yes / no",
  },
  {
    name: "apply",
    text: "Writes the pinned bundle to your repository.",
    detail: "version-pinned",
  },
  {
    name: "rollback",
    text: "If any step fails, the whole run is restored.",
    detail: "idle unless a step fails",
    idle: true,
  },
  {
    name: "ledger",
    text: "Every change is recorded in .agemon/state.json.",
    detail: ".agemon/state.json",
  },
];
---

<div class="safety-diagram">
  <div class="track" aria-hidden="true"></div>
  <div class="progress" aria-hidden="true"></div>
  <ol>
    {
      steps.map(({ name, text, detail, idle }) => (
        <li>
          <span class:list={["step-dot", { idle }]} aria-hidden="true" />
          <b>{name}</b>
          <span class="step-text">{text}</span>
          <code class="ag-label">{detail}</code>
        </li>
      ))
    }
  </ol>
  <div class="failure-branch" aria-hidden="true">
    <div class="branch from-apply"></div>
    <div class="branch to-plan"></div>
    <div class="branch from-rollback"></div>
  </div>
  <p class="failure-caption">Failure branch: any step fails → the whole run is restored</p>
</div>

<style>
  .safety-diagram {
    position: relative;
  }

  .track,
  .progress {
    position: absolute;
    inset-inline: 10%;
    top: 11px;
    height: 2px;
  }

  .track {
    background: var(--ag-border);
  }

  .progress {
    background: var(--ag-secondary);
    transform-origin: left;
  }

  ol {
    position: relative;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    text-align: center;
  }

  .step-dot {
    position: relative;
    width: 24px;
    height: 24px;
    border: 2.6px solid var(--ag-text);
    border-radius: 50%;
    background: var(--ag-bg);
  }

  .step-dot::after {
    content: "";
    position: absolute;
    inset: -2.6px;
    border-radius: 50%;
    background: var(--ag-accent);
  }

  .step-dot.idle::after {
    display: none;
  }

  b {
    font-family: var(--sl-font-mono);
    font-size: 0.9375rem;
  }

  .step-text {
    color: var(--ag-text-muted);
    font-size: 0.9375rem;
  }

  .failure-branch {
    position: relative;
    height: 6rem;
    margin-top: 2rem;
  }

  .branch {
    position: absolute;
    top: 0;
    border: 0 dashed var(--ag-danger);
  }

  .from-apply {
    left: 50%;
    width: 20%;
    height: 2.75rem;
    border-width: 0 2px 2px;
  }

  .to-plan {
    left: 10%;
    width: 60%;
    height: 5rem;
    border-width: 0 0 2px 2px;
  }

  .from-rollback {
    left: 70%;
    top: 2.75rem;
    height: 2.25rem;
    border-left-width: 2px;
  }

  .failure-caption {
    margin: 0;
    color: var(--ag-danger);
    font: 0.875rem var(--sl-font-mono);
    text-align: center;
  }

  @media (max-width: 50rem) {
    ol {
      grid-template-columns: minmax(0, 1fr);
    }

    li {
      align-items: flex-start;
      text-align: start;
    }

    .track,
    .progress,
    .failure-branch {
      display: none;
    }
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .progress {
        animation: safety-progress linear both;
        animation-timeline: view();
        animation-range: cover 25% cover 65%;
      }

      .step-dot::after {
        animation: safety-step linear both;
        animation-timeline: view();
        animation-range: entry 30% entry 90%;
      }
    }
  }

  @keyframes safety-progress {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  @keyframes safety-step {
    from {
      opacity: 0;
      transform: scale(0.4);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }
</style>
